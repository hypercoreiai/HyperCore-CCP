# IDEs
.vscode/
.idea/
.cursor/

/.ccache/
/.rocm-win/

# local endpoint/key cache for the Assist tab
/.env

# Archived web snapshots (serve/data): the fetched page dumps are regenerable scratch;
# the parsed catalogue JSON/CSV/markdown next to them is kept.
serve/data/nvidia_free_models/raw/

# The Assist call log the Monitor reads; regenerated on every request.
serve/data/assist_calls.jsonl

# The design transcript that this project was built from: 8 MB of chat, kept in the
# working tree as context, not as source. It is the only name left containing 'strata'.
/strata-chat-*.md


# ----------------------------------------------------------------------
# Repository hygiene: nothing below is project source.
# ----------------------------------------------------------------------

# Agent session state (loop counters, targets, queues). Local working context only.
/.blackbox_scan_state.json
/.hypercore_rename_state.json
/.mcp_test_state.json

# The Assist call log the Monitor reads; regenerated on every request.
/serve/assist_calls.jsonl

# Design transcripts and chat dumps kept in the tree as context, never as source.
strata-chat-*.md
docs/strata-chat-*.md
*-chat-*.md
# The per-transcript summaries tools/build_history.py writes under data/history/chats/
# are part of the built index, not raw dumps, so the rule above must not swallow them.
!data/history/chats/*-chat-*.md
# Raw transcripts copied into the history folder are context for the chat, not the built
# index. They carry the machine's own tokens, so they stay out of the repository.
data/history/chats/hypercore-chat-*.md
data/history/chats/strata-chat-*.md
data/history/chats/unknown-*.md

# Archived history of the pre-restart repository (see README, "History").
project_history_*
*.git.bundle

# Backups and leftover copies of files that already have a tracked original.
*.bak
*.orig
*.rej
*.copy

# One-off run captures and review notes.
.run_all*.txt
.review_*.txt
.bb_*.txt
.ci_*.txt
.full_suite*.txt
.check_*.txt
*.out

# Scratch and tooling artifacts.
/tmp/
*.tmp
*.nsys-rep
*.nvprof
.coverage
htmlcov/

# Local run scripts written by setup on this machine (same class as run-*.sh).
/_hypercore_run-*.sh
/run_hypercore_*.sh

# Checkpoint helper: local tooling, not project source.
/cp_blackbox.sh

# The chat history under data/history/ is generated by tools/build_history.py from the
# transcripts in ~/black_box_chats, with keys, addresses and handles scrubbed on the way
# out, so it is safe to commit. The _old_* folders are the unscrubbed tree from before
# the scrubber existed; they are kept locally for reference only.
data/history/_old_chats/
data/history/_old_topics/

# ----------------------------------------------------------------------
# optuna_tune: the Bayesian (Optuna) sweep and everything it generates.
# Local tuning tooling and its measured results, not project source: the search
# writes max_run_<model>.sh/.json at the root and a CSV per run under optuna_tune/results/.
/optuna_tune/
max_run_*.sh
max_run_*.json
/optuna_tune/results/
max_run_*.pid
max_run_*.fifo
# The Optuna sweep's own session state, same class as .mcp_test_state.json.
/.optuna_tune_state.json

# ----------------------------------------------------------------------
# Run scripts and configs setup.py writes on the user's machine. Same class as
# max_run_*: they describe this install's model and flags, not the project.
/ni_*.sh
/ni_*.json
/_max_run_*.sh
/_max_run_*.json
/[0-9]*_max_run_*.sh
/[0-9]*_max_run_*.json

# The model directory is a symlink to the downloaded pack, outside the repo.
/Q2_0

# Tuning harness output: logs and per-run results, regenerated on every sweep.
/tune/*.log
/tune/results/
/tune/__pycache__/

# Local scan and calibration state, same class as .mcp_test_state.json.
/state.md
/.calibrate_result.json
/.calibrate_progress.log
/.blackbox_scan_state.json
/.verify_all_tests_state.json

# verify_all_tests.sh transcripts: every run writes a new one under bench/results/verify-<date>/
# and compares it with the previous one, so they are working output, not source.
bench/results/verify-*/
bench/results/verify-*.log
bench/results/verify-*.json

# Local scratch for probes and patches.
/scratch/

# Run scripts the tuning sweep and the Strata-side helpers write next to run-<model>.sh:
# they name this machine's model paths, the same class as ni_*.sh and max_run_*.sh.
/ni*_run-*.sh
/start/
